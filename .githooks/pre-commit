#!/usr/bin/env bash
# pre-commit hook: py_compile all staged .py files
echo "=== pre-commit: py_compile ==="
for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\.py$'); do
  if [ -f "$f" ]; then
    python3 -m py_compile "$f" && echo "  OK $f" || { echo "  FAIL $f"; exit 1; }
  fi
done
echo "  all staged .py files OK"

# ── ref-guard: 删掉的符号不得还有引用 ──────────────────────────────────
# 实测 2026-10-22 一天内 main 红过 4 次，两类根因都在这里：
#   ef2a249 整文件覆盖抹掉 dce5d77 的 own_written 实现（测试仍在调用）
#   74bf13c main 上 role_lifecycle 缺 pane_cli_busy，导入即 ImportError
# 只查"暂存区删掉的 def/class 名在删除后仍被 src/tests 引用"——改名、连调用点一起删、
# 连测试一起删都不会误报。真需保留残留引用设 ALLOW_DANGLING_REF=1。
if [ "$ALLOW_DANGLING_REF" != "1" ]; then
  python3 - <<'PY' || exit 1
import ast, re, subprocess, sys
def git(*a, **kw):
    return subprocess.run(["git", *a], capture_output=True, text=True, **kw).stdout
removed = {m.group(1) for m in re.finditer(r"^-\s*(?:def|class)\s+([A-Za-z_]\w*)",
                                         git("diff", "--cached", "-U0", "--", "*.py"), re.M)}
if not removed:
    sys.exit(0)
refs = {}
for f in git("ls-files", "-z", "src", "tests").split("\0"):
    if not f.endswith(".py"):
        continue
    try:
        tree = ast.parse(git("show", ":" + f))
    except SyntaxError:
        continue
    # 只看真代码引用：注释/文档里提到旧名字（本仓大量存在）不算调用
    for n in ast.walk(tree):
        if isinstance(n, ast.Name):
            nm = n.id
        elif isinstance(n, ast.Attribute):
            nm = n.attr
        elif isinstance(n, ast.alias):
            nm = (n.asname or n.name).split(".")[-1]
        else:
            continue
        if nm in removed:
            refs.setdefault(nm, set()).add(f)
if refs:
    print("REF-GUARD 阻止提交: 删掉的符号还有代码引用", file=sys.stderr)
    for nm, fs in sorted(refs.items()):
        print(f"  {nm} ← {', '.join(sorted(fs))}", file=sys.stderr)
    print("  要么连调用点一起删/改，要么别删。确需保留设 ALLOW_DANGLING_REF=1。", file=sys.stderr)
    sys.exit(1)
PY
fi

# ── revert-guard: 拒绝“历史回滚”型裸提交 ──────────────────────────────
# 暂存内容与 HEAD 不同、却恰好等于近 50 个提交中的某个旧版本，说明工作树/暂存区被旧版本
# 覆盖；一次裸 commit 会静默回滚已合入的修复。实测 2026-10-22 三个仓同时命中：
#   wt-launcher 倒退 a7e6a1f(测试写生产总线守卫)+e08873b(脏 epoch 守卫)
#   hermes-session-roles 倒退 72ce807 的 prompts/base.md
#   session-pipeline 倒退 engine.py 到旧 blob
# 真需回滚用 git revert <commit>；确要旧内容设 ALLOW_HISTORY_ROLLBACK=1。
if [ "$ALLOW_HISTORY_ROLLBACK" != "1" ]; then
  for path in $(git diff --cached --name-only -z | tr '\0' '\n'); do
    staged=$(git rev-parse ":$path" 2>/dev/null) || continue
    head=$(git rev-parse "HEAD:$path" 2>/dev/null) || continue
    [ "$staged" = "$head" ] && continue
    for c in $(git rev-list --max-count=50 HEAD); do
      old=$(git rev-parse "$c:$path" 2>/dev/null) || continue
      if [ "$old" = "$staged" ]; then
        echo "REVERT-GUARD 阻止提交: $path 的暂存内容等于历史版本 $c，提交会静默回滚已合入的修复。真需回滚用 git revert；确要旧内容设 ALLOW_HISTORY_ROLLBACK=1。" >&2
        exit 1
      fi
    done
  done
fi
