#!/bin/bash
# SET-01: git pre-commit hook — 提交前自动跑测试
# 安装: cp tests/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e
ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

echo "=== SET Pre-commit: 运行测试 ==="

# 只跑改动的模块相关测试
CHANGED=$(git diff --cached --name-only --diff-filter=ACM)

RUN_ALL=false
RUN_ROUTER=false
RUN_INTEGRATION=false
RUN_ROLE=false

for f in $CHANGED; do
    case "$f" in
        src/router.py) RUN_ROUTER=true ;;
        src/auto_route.py) RUN_INTEGRATION=true ;;
        src/reliability.py) RUN_INTEGRATION=true ;;
        src/workflow_db.py) RUN_ALL=true ;;
        src/workflow_engine.py) RUN_ALL=true ;;
        src/workflow_daemon.py) RUN_ALL=true ;;
        tests/*) RUN_ALL=true ;;
    esac
done

PASSED=0
FAILED=0

run_test() {
    local name=$1
    local cmd=$2
    echo -n "  $name ... "
    if eval "$cmd" 2>/dev/null | tail -1; then
        echo "  ✅ $name"
        PASSED=$((PASSED + 1))
    else
        echo "  ❌ $name"
        FAILED=$((FAILED + 1))
    fi
}

if [ "$RUN_ALL" = true ] || [ "$RUN_ROUTER" = true ]; then
    run_test "路由逻辑" "python3 tests/test_router.py"
fi
if [ "$RUN_ALL" = true ] || [ "$RUN_INTEGRATION" = true ]; then
    run_test "集成测试" "python3 tests/test_integration.py"
fi
if [ "$RUN_ALL" = true ] || [ "$RUN_ROLE" = true ]; then
    run_test "角色交互" "python3 tests/test_role_interaction.py"
fi

echo "=== 结果: $PASSED 通过, $FAILED 失败 ==="
[ "$FAILED" -eq 0 ] || exit 1
